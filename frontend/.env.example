# Leave VITE_API_URL empty (or unset) so the API (/api) and websocket (/ws) use the address
# in the browser bar. That is what makes the app work from other computers on the network.
#
# Only set it to reach an API on a different origin. It is a bare origin, without /api:
#   VITE_API_URL=https://api.example.com
VITE_API_URL=

# Same idea for the socket.io (realtime) service. Falls back to VITE_API_URL, then to the page address.
# Only needed when realtime is on a different origin, e.g. `pnpm dev` with split ports:
#   VITE_API_URL=http://localhost:31126
#   VITE_REALTIME_URL=http://localhost:3000
# Bare origin only (no path), the URL path would be read as a socket.io namespace.
VITE_REALTIME_URL=

# Optional, cache-busting SvelteKit version name (default 1)
# BUILD_VERSION=1
