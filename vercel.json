{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "backend/",
            "framework": "go",
            "entrypoint": "main.go"
        },
        "realtime": {
            "root": "realtime/",
            "framework": "node"
        },
        "frontend": {
            "root": "frontend/",
            "framework": "sveltekit"
        }
    },
    "rewrites": [
        {
            "source": "/ws/(.*)",
            "destination": {
                "service": "realtime"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
