{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "backend/",
            "framework": "go",
            "entrypoint": "main.go",
            "buildCommand": "go build -ldflags '-s -w' -o server . && if [ \"$VERCEL_ENV\" = production ]; then ./server -migrate; fi"
        },
        "realtime": {
            "root": "realtime/",
            "framework": "node",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "API_URL"
                }
            ]
        },
        "mcp": {
            "root": "mcp/",
            "framework": "xmcp",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "API_URL"
                }
            ]
        },
        "frontend": {
            "root": "frontend/",
            "framework": "sveltekit-1"
        }
    },
    "rewrites": [
        {
            "source": "/ws/(.*)",
            "destination": {
                "service": "realtime"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/mcp",
            "destination": {
                "service": "mcp"
            }
        },
        {
            "source": "/mcp/(.*)",
            "destination": {
                "service": "mcp"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
