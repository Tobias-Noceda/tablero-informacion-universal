# Only for running the realtime service outside docker compose (or on Vercel).
# Compose injects its own values from the root .env

# Listen port (default 3000)
PORT=3000

# Required. The change stream needs MongoDB running as a replica set
MONGODB_URI=mongodb://user:password@localhost:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGO_DATABASE=prod

# Required. The password goes inside the URL: redis://:<password>@host:6379/ (URL-encode special characters)
REDIS_URL=redis://:password@localhost:6379/
