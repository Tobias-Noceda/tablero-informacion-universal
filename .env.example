# Backend
MONGODB_URI=
MONGO_DATABASE=prod
REDIS_URL=

# Master key ring for the secrets vault: <version>:<base64 of 32 random bytes>[,<version>:<base64>...]
# Generate one with: openssl rand -base64 32
# The highest version seals; every listed version can open. See README "Secrets vault" for rotation.
SECRETS_MASTER_KEYS=1:REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# docker-compose (Mongo container + integration test scripts)
MONGO_INITDB_ROOT_USERNAME=user
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=prod
