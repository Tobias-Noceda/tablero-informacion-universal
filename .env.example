# Used by docker compose (`docker compose up --build`). Copy to .env
# Passwords are placed inside connection URLs, keep them URL-safe (letters, digits, - _ .)

# MongoDB root user (also used by backend and realtime)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_DATABASE=prod

# Redis password
REDIS_PASSWORD=change-me-redis

# Backend secrets encryption keys: <version>:<base64 of 32 random bytes>
# Generate one with: echo "1:$(openssl rand -base64 32)"
SECRETS_MASTER_KEYS=1:REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# Session signing keys (Ed25519 seeds): <kid>:<base64 of 32 random bytes>, comma separated for rotation
# Generate one with: echo "k1:$(openssl rand -base64 32)"
AUTH_SIGNING_KEYS=k1:REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# Emails that become platform admins when they sign in (comma separated)
PLATFORM_ADMINS=

# The refresh cookie is Secure by default; set to false only for plain-HTTP development (e.g. http://localhost or a LAN IP)
AUTH_COOKIE_SECURE=false

# Not needed here: the frontend derives the API and websocket URL from the page address,
# so the app works from any host/IP. See frontend/.env.example
REDIS_PASSWORD=change-me-redis