# Only for running the backend outside docker compose (`go run main.go`) or on Vercel.
# Compose injects its own values from the root .env

# Listen port
PORT=31126

# Defaults if unset: mongo:27017 (user:password) and prod
MONGODB_URI=mongodb://user:password@localhost:27017/?authSource=admin
MONGO_DATABASE=prod

# Default if unset: redis://redis:6379/
# The password goes inside the URL: redis://:<password>@host:6379/ (URL-encode special characters)
REDIS_URL=redis://:password@localhost:6379/

# Required. <version>:<base64 of 32 random bytes>, comma separated for key rotation
# Generate one with: echo "1:$(openssl rand -base64 32)"
SECRETS_MASTER_KEYS=1:REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

VERCEL=1