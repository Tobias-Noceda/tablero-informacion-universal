{{define "layout"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{template "subject" .}}</title>
<style>
  body { margin: 0; padding: 0; width: 100% !important; background: #eef4f5; }
  a { color: #005166; }
  .button:hover { background: #056a78 !important; border-color: #056a78 !important; }
  @media (max-width: 520px) {
    .shell { padding: 16px 8px !important; }
    .content { padding: 28px 22px !important; }
  }
</style>
</head>
<body style="margin: 0; padding: 0; background: #eef4f5;">
<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all;">{{template "preheader" .}}&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #eef4f5;">
  <tr>
    <td class="shell" align="center" style="padding: 40px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 520px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111827;">
        <tr>
          <td style="background: #005166; border-radius: 12px 12px 0 0; padding: 22px 32px; border-bottom: 4px solid #6fa3ac;">
            <span style="font-size: 17px; font-weight: 700; letter-spacing: 0.2px; color: #ffffff;">Tablero de Información Universal</span>
          </td>
        </tr>
        <tr>
          <td class="content" style="background: #ffffff; border-radius: 0 0 12px 12px; padding: 36px 32px; font-size: 15px; line-height: 1.6;">
            <h1 style="margin: 0 0 20px; font-size: 22px; line-height: 1.3; font-weight: 700; color: #005166;">{{template "heading" .}}</h1>
            {{template "greeting" .}}
            {{template "html" .}}
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0;">
              <tr>
                <td style="border-radius: 8px; background: #005166;">
                  <a class="button" href="{{.Link}}" target="_blank" style="display: inline-block; padding: 13px 24px; border: 1px solid #005166; border-radius: 8px; background: #005166; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;">{{template "action" .}}</a>
                </td>
              </tr>
            </table>
            <p style="margin: 0 0 4px; font-size: 13px; color: #4b5563;">{{template "fallback" .}}</p>
            <p style="margin: 0 0 28px; font-size: 13px; word-break: break-all;"><a href="{{.Link}}" target="_blank" style="color: #005166;">{{.Link}}</a></p>
            <p style="margin: 0; padding-top: 20px; border-top: 1px solid #e5e7eb; font-size: 13px; color: #6b7280;">{{template "note" .}}</p>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding: 24px 32px 0; font-size: 12px; line-height: 1.5; color: #6b7280;">
            {{template "footer" .}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>{{end}}
