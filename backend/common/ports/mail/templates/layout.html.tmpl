{{define "layout"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{template "subject" .}}</title>
<style>
  body { margin: 0; padding: 0; background: #f4f4f5; color: #18181b; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; }
  .card { max-width: 480px; margin: 32px auto; padding: 32px; background: #ffffff; border-radius: 12px; }
  .button { display: inline-block; padding: 12px 20px; background: #18181b; color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; }
  .fallback { word-break: break-all; color: #52525b; font-size: 13px; }
  .note { color: #71717a; font-size: 13px; }
</style>
</head>
<body>
<div class="card">
{{template "html" .}}
</div>
</body>
</html>{{end}}
